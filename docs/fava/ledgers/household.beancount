; Example ledger for the Year in Review and Cash Flow screenshots (see
; screenshots.py): two years of a household's pay, home and mortgage, savings,
; investments and spending.
option "title" "Household"
option "operating_currency" "USD"

2022-12-01 custom "fava-extension" "beancount_sg.ext.year_end"
2022-12-01 custom "fava-extension" "beancount_sg.ext.cash_flow"

2022-12-01 open Equity:Opening-Balances
2022-12-01 open Income:Salary USD
2022-12-01 open Liabilities:CreditCard USD
2022-12-01 open Expenses:Food:Groceries USD
2022-12-01 open Expenses:Food:Restaurants USD
2022-12-01 open Expenses:Travel USD
2022-12-01 open Expenses:Shopping USD

2022-12-01 open Assets:Home USD
2022-12-01 open Assets:Bank:Savings USD
2022-12-01 open Assets:Brokerage
  cash-flow-role: "investing"
2022-12-01 open Liabilities:Home:Mortgage USD
2022-12-01 open Expenses:Home:MortgageInterest USD
2022-12-01 open Expenses:Home:Utilities USD
2022-12-01 open Expenses:Insurance USD

