; Example ledger for the Fava extension screenshots (see screenshots.py).
option "title" "Example"
option "operating_currency" "USD"

2024-01-01 custom "fava-extension" "beancount_sg.ext.checkbook"
2024-01-01 custom "fava-extension" "beancount_sg.ext.batch_edit"
2024-01-01 custom "fava-extension" "beancount_sg.ext.rewards"
2024-01-01 custom "fava-extension" "beancount_sg.ext.update_status"
2024-01-01 custom "fava-extension" "beancount_sg.ext.travel"
2024-01-01 custom "fava-extension" "beancount_sg.ext.payees"
2024-01-01 custom "fava-extension" "beancount_sg.ext.year_end"

2024-01-01 open Assets:Bank:Checking USD
  fava-uptodate-indication: TRUE
2024-01-01 open Equity:Opening-Balances
2024-01-01 open Liabilities:CreditCard:CashPlus USD
  fava-uptodate-indication: TRUE
  rewards: "cashback"
  rewards-rate: 1.5
  rewards-rate-groceries: 3
2024-01-01 open Liabilities:CreditCard:Voyager USD
  fava-uptodate-indication: TRUE
  rewards: "points"
  rewards-rate-dining: 3
  rewards-rate-travel: 2
  rewards-unit: "VP"
  rewards-point-value: 0.0125
2024-01-01 open Expenses:Food:Groceries
2024-01-01 open Expenses:Food:Restaurants
2024-01-01 open Expenses:Home:Repairs
2024-01-01 open Expenses:Home:Garden
2024-01-01 open Expenses:Shopping
2024-01-01 open Expenses:Travel
2024-01-01 open Expenses:Travel:Lodging
2024-01-01 open Expenses:Travel:Transport
2024-01-01 open Assets:Cash USD
2024-01-01 open Expenses:Uncategorized
2024-01-01 open Income:Salary

